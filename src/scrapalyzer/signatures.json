{
  "_format": "Wappalyzer-style subset. Kinds: headers {name-regex: value-regex}, cookies [name-regex], scriptSrc [regex], html [regex], meta {name: value-regex}, status [int]. All regexes are case-insensitive. Every entry needs a positive and a negative test.",
  "technologies": {
    "Next.js": {"cats": ["framework"], "headers": {"x-powered-by": "Next\\.js"}, "html": ["<script id=\"__NEXT_DATA__\"", "self\\.__next_f\\.push"], "scriptSrc": ["/_next/static/"], "implies": ["React"],
                "hint": "Page data is usually in __NEXT_DATA__ or the RSC payload; /_next/data/{buildId}/{path}.json serves it as JSON on pages-router sites"},
    "Nuxt": {"cats": ["framework"], "html": ["window\\.__NUXT__", "<script[^>]+id=\"__NUXT_DATA__\""], "scriptSrc": ["/_nuxt/"], "implies": ["Vue.js"],
             "hint": "Page data is usually in the __NUXT__ / __NUXT_DATA__ payload"},
    "Gatsby": {"cats": ["framework"], "html": ["<div id=\"___gatsby\""], "meta": {"generator": "^Gatsby"}, "implies": ["React"],
               "hint": "Static pages; /page-data/{path}/page-data.json carries page data"},
    "SvelteKit": {"cats": ["framework"], "html": ["data-sveltekit-", "__sveltekit_"],
                  "hint": "Server load data is usually inlined; {path}/__data.json may serve it"},
    "Astro": {"cats": ["framework"], "html": ["<astro-island"], "meta": {"generator": "^Astro"}},
    "Angular": {"cats": ["framework"], "html": ["ng-version=\""]},
    "React": {"cats": ["js-library"], "html": ["data-reactroot"], "scriptSrc": ["react(-dom)?(\\.production)?(\\.min)?\\.js"]},
    "Vue.js": {"cats": ["js-library"], "html": ["data-v-[0-9a-f]{8}"], "scriptSrc": ["vue(\\.runtime)?(\\.global)?(\\.prod)?(\\.min)?\\.js"]},
    "Apollo GraphQL": {"cats": ["api"], "html": ["__APOLLO_STATE__"], "hint": "A GraphQL endpoint (often /graphql) backs the page"},
    "Shopify": {"cats": ["commerce"], "headers": {"x-shopid": "", "x-shopify-stage": ""}, "cookies": ["^_shopify_y$", "^_shopify_s$"], "scriptSrc": ["cdn\\.shopify\\.com"], "html": ["Shopify\\.theme"],
                "hint": "/products.json and /collections/{handle}/products.json are common platform endpoints"},
    "WooCommerce": {"cats": ["commerce"], "html": ["woocommerce-"], "scriptSrc": ["/wp-content/plugins/woocommerce/"], "implies": ["WordPress"],
                    "hint": "/wp-json/wc/store/v1/products is the platform's public Store API"},
    "Magento": {"cats": ["commerce"], "cookies": ["^X-Magento-Vary$"], "html": ["Magento_", "mage/cookies"], "scriptSrc": ["/static/version\\d+/frontend/"],
                "hint": "/graphql and /rest/V1/ are the platform's APIs"},
    "BigCommerce": {"cats": ["commerce"], "scriptSrc": ["cdn\\d*\\.bigcommerce\\.com"], "html": ["data-stencil-"],
                    "hint": "The storefront GraphQL API is at /graphql"},
    "Salesforce Commerce Cloud": {"cats": ["commerce"], "cookies": ["^dwsid$", "^dwanonymous_"], "html": ["/on/demandware\\.store/", "/on/demandware\\.static/"],
                                  "hint": "Listing grids usually load from /on/demandware.store/.../Search-UpdateGrid"},
    "WordPress": {"cats": ["cms"], "html": ["/wp-content/", "/wp-includes/"], "meta": {"generator": "^WordPress"}, "headers": {"link": "rel=\"https://api\\.w\\.org/\""},
                  "hint": "/wp-json/wp/v2/posts is the REST API, often public"},
    "Drupal": {"cats": ["cms"], "headers": {"x-generator": "Drupal", "x-drupal-cache": ""}, "meta": {"generator": "^Drupal"}, "html": ["drupal-settings-json"],
               "hint": "/jsonapi is the core JSON:API module, when enabled"},
    "Ghost": {"cats": ["cms"], "meta": {"generator": "^Ghost"}, "hint": "/ghost/api/content/ is the Content API (needs the site's public key)"},
    "Squarespace": {"cats": ["cms"], "html": ["static1\\.squarespace\\.com", "Static\\.SQUARESPACE_CONTEXT"], "hint": "Adding ?format=json to most pages returns JSON"},
    "Wix": {"cats": ["cms"], "headers": {"x-wix-request-id": ""}, "html": ["static\\.wixstatic\\.com"], "meta": {"generator": "^Wix"}},
    "Webflow": {"cats": ["cms"], "html": ["data-wf-site=\""], "meta": {"generator": "^Webflow"}},
    "Algolia": {"cats": ["search"], "scriptSrc": ["algoliasearch", "cdn\\.jsdelivr\\.net/npm/algoliasearch"], "html": ["\\.algolia\\.net", "\\.algolianet\\.com"],
                "hint": "Search queries go to Algolia's API from the browser"},
    "ASP.NET": {"cats": ["server"], "headers": {"x-aspnet-version": "", "x-powered-by": "ASP\\.NET"}, "cookies": ["^ASP\\.NET_SessionId$"], "html": ["name=\"__VIEWSTATE\""]},
    "PHP": {"cats": ["server"], "headers": {"x-powered-by": "PHP"}, "cookies": ["^PHPSESSID$"]},
    "Express": {"cats": ["server"], "headers": {"x-powered-by": "^Express$"}}
  },
